# Data: the UNSW-NB15 partitions ship with the repository; everything else is
# downloaded separately (see data/README.md).
data/*.csv
!data/train.csv
!data/test.csv
data/cicids2017/

# Experiment outputs: everything is regenerated; only the layout README is
# tracked so a fresh clone documents where artefacts will appear.
outputs/*
!outputs/README.md
# Local backup of the experiment tree; regenerated on demand, never committed.
outputs.zip

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db


# Normalise every text file to LF so the repository stays consistent
# regardless of the contributor's operating system.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.pdf binary
*.jpg binary

# The shipped dataset partitions are large text files: never diff them and keep
# them out of GitHub's language statistics.
data/train.csv -diff linguist-vendored
data/test.csv  -diff linguist-vendored
